[Unit]
Description=homelab-core local homelab agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/homelab-core/.venv/bin/homelab-core
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
User=homelab
Group=homelab
SupplementaryGroups=spi gpio i2c input
StateDirectory=homelab-core
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
